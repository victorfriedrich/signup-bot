# The event site and its Auth0 login (see "Site settings" in the README)
SITE_URL=
AUTH_URL=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

# Your login on the event site (email + password account)
LOGIN_EMAIL=
LOGIN_PASSWORD=
# Only if you log in with Google/Microsoft/Facebook (untested): the value of the "auth0" cookie on AUTH_URL
AUTH0_SESSION_COOKIE=

# watch, launch, or both
MODE=both
# Waiting list: event ids or URLs, comma separated
WATCH_EVENTS=
# Sign-up at opening time: events whose series (same title) to follow, comma separated
LAUNCH_EVENTS=
# Optional fallback for both lists when they're empty
EVENT=
# Override the series title launch mode follows for EVENT
SERIES_TITLE=

TIMEZONE=Europe/Berlin
WATCH_INTERVAL_MIN=5
WATCH_HOURS=9-2
# Stop waiting for a cancellation this many hours before the event starts
WATCH_STOP_HOURS=3

LAUNCH_LEAD_MS=1000
LAUNCH_RETRY_MS=150
LAUNCH_WINDOW_S=20

# Decodo proxy: either the full URL, or username/password (+ endpoint)
DECODO_PROXY_URL=
DECODO_USERNAME=
DECODO_PASSWORD=
DECODO_ENDPOINT=gate.decodo.com:10001
# off = proxy unused; auth = only the Auth0 login goes through it; all = API calls too (slower launch)
PROXY_MODE=off

# Mount a Railway volume here to keep the login across restarts
STATE_DIR=/data
# true = do everything except actually registering
DRY_RUN=false
# Optional push notification, e.g. https://ntfy.sh/some-private-topic
NTFY_URL=
